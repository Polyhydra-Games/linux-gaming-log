{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "machines.yaml",
  "type": "object",
  "required": ["machines"],
  "additionalProperties": false,
  "properties": {
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "distro": { "type": "string" },
          "ip": { "type": "string", "format": "ipv4" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
